[paths]
# cartella dell'export CORDIS: vecchio formato (project.json, organization.json, ...) o un
# file json per progetto (project-rcn-*.json); il formato è riconosciuto da cordis_loader.py
new_data_folder_name = new_data/2026-10-15
# embedding precalcolati dei progetti nuovi, parquet (projectID, vector) scritti da
# compute_embeddings.py --source new; vuoto = calcolati da update_db.py
bge_embedding_file = new_data/bge_2026-10-15.parquet
specter2_embedding_file = new_data/specter2_2026-10-15.parquet
# deliverables con gli autori, parquet scritto da extract_deliverables.py; vuoto = update_db.py
# usa i deliverables dell'export e gli autori già nel db (senza leggere pdf nuovi)
deliverables_file =
# .env con LLM_API_KEY, LLM_BASE_URL, LLM_MODEL (servizio LLM) per extract_deliverables.py
deliverables_env_path = .env
# fonte esterna delle pubblicazioni (non ancora gestita da update_db.py); vuoto = si usano
# quelle dell'export, solo per i progetti con n_publications == 0
publications_file =

[topics]
similarity_threshold = 0.92
min_cluster_size = 5
review_file = new_data/topic_review.xlsx
reviewed_topic_bonus = 0.02
reviewed_topic_bonus_existing = -0.005

# nomi delle colonne di project.json e organization.json: usati solo con il vecchio formato
[columns]
proj_id = id
proj_title = title
proj_objective = objective
proj_fp = frameworkProgramme
proj_acronym = acronym
org_id = organisationID
org_name = name
org_country_code = country
org_activity_type = activityType
org_role = role
org_proj_ec_contribution = netEcContribution
org_proj_id = projectID